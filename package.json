{
  "name": "psd",
  "description": "A general purpose Photoshop file parser for Node and the browser.",
  "version": "4.0.0",
  "license": "MIT",
  "author": "Ryan LeFevre (https://github.com/meltingice)",
  "type": "module",
  "keywords": [
    "psd",
    "psb",
    "parser",
    "photoshop",
    "adobe",
    "reader"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meltingice/psd.js.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
